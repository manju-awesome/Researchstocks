//@version=6
indicator(title = "SVMKR_UT_HMA_ORB", overlay = true, max_lines_count = 500)

// Perfect working version 19
//
// This file is the SOURCE OF TRUTH that src/spydaytrader/core/signal_engine.py
// mirrors. If you change an input here, change it in .env too — the two
// silently disagreeing is the failure mode to watch for. It has happened once
// already: the ORB session below is 15 minutes (0930-0945), while the input
// titled "ORB total time (minutes)" is 5 and does NOT control the window.

//----------------------UT BOT-----------------------
// Inputs
a = input.int(2, title = "UT Key Vaule. 'This changes the sensitivity'")
c = input.int(1, title = "UT ATR Period")
h = input.bool(false, title = "Signals from Heikin Ashi Candles")

xATR  = ta.atr(c)
nLoss = a * xATR

src = h ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close, lookahead = barmerge.lookahead_off) : close

xATRTrailingStop = 0.0
xATRTrailingStop := src > nz(xATRTrailingStop[1], 0) and src[1] > nz(xATRTrailingStop[1], 0) ? math.max(nz(xATRTrailingStop[1]), src - nLoss) :
     src < nz(xATRTrailingStop[1], 0) and src[1] < nz(xATRTrailingStop[1], 0) ? math.min(nz(xATRTrailingStop[1]), src + nLoss) :
     src > nz(xATRTrailingStop[1], 0) ? src - nLoss : src + nLoss
pos = 0
pos :=  src[1] < nz(xATRTrailingStop[1], 0) and src > nz(xATRTrailingStop[1], 0) ? 1 :
     src[1] > nz(xATRTrailingStop[1], 0) and src < nz(xATRTrailingStop[1], 0) ? -1 : nz(pos[1], 0)
xcolor = pos == -1 ? color.red: pos == 1 ? color.green : color.blue

ema   = ta.ema(src,1)
above = ta.crossover(ema, xATRTrailingStop)
below = ta.crossover(xATRTrailingStop, ema)

buy  = src > xATRTrailingStop and above
sell = src < xATRTrailingStop and below

barbuy  = src > xATRTrailingStop
barsell = src < xATRTrailingStop

plotshape(buy,  title = "Buy",  text = 'Buy',  style = shape.labelup,   location = location.belowbar, color= color.green, textcolor = color.white, size = size.tiny)
plotshape(sell, title = "Sell", text = 'Sell', style = shape.labeldown, location = location.abovebar, color= color.red,   textcolor = color.white, size = size.tiny)

//Uncomment below lines if you want UT bar colors
//barcolor(barbuy  ? color.green : na)
//barcolor(barsell ? color.red   : na)

// Kept for backwards compatibility — these still work if you prefer two
// separate alerts. The combined alert() at the bottom of this file does the
// same job in ONE alert slot and carries context in the message.
alertcondition(buy,  "UT Long",  "UT Long")
alertcondition(sell, "UT Short", "UT Short")

//----------------------Hull Moving Average-----------------------
n = input.int(31, title="Hull MA Period")


// HMA Calculation
n2ma = 2 * ta.wma(close, math.round(n / 2))
nma = ta.wma(close, n)
diff = n2ma - nma
sqn = math.round(math.sqrt(n))

n2ma1 = 2 * ta.wma(close[1], math.round(n / 2))
nma1 = ta.wma(close[1], n)
diff1 = n2ma1 - nma1
sqn1 = math.round(math.sqrt(n))

n1 = ta.wma(diff, sqn)
n2 = ta.wma(diff1, sqn)
c1 = n1 > n2 ? color.green : color.red

// Plot HMA
plot(n1, color = c1,linewidth = 2, title = "HullMA")


//----------------------Dotted moving averages (200 SMA + 8 EMA)-----------------------
// Note: plot() has no dotted style in Pine, so these MAs are drawn using
// line.new with line.style_dotted, one segment per bar. A FIFO array per MA
// keeps only the most recent segments so each line stays a continuous dotted
// trail instead of being wiped every bar.
//
// BUDGET: max_lines_count in the indicator() header is a limit for the WHOLE
// script, not per drawing. Two dotted MAs therefore split it — 245 each, 490
// total, leaving headroom under 500. Do not raise either cap without lowering
// the other: past the limit Pine silently deletes the oldest lines out from
// under the arrays and the trails start breaking at random points.
maSegments = 245

ma200len = input.int(200, title = "200 MA Length")
ma200src = input.source(close, title = "200 MA Source")
ma200 = ta.sma(ma200src, ma200len)

var line[] ma200Lines = array.new<line>(0)

if not na(ma200[1]) and not na(ma200)
    newLine = line.new(x1 = bar_index[1], y1 = ma200[1], x2 = bar_index, y2 = ma200,
         xloc = xloc.bar_index, extend = extend.none,
         color = color.orange, style = line.style_dotted, width = 2)
    array.push(ma200Lines, newLine)
    if array.size(ma200Lines) > maSegments
        line.delete(array.shift(ma200Lines))

// 8 EMA — same dotted treatment, drawn dark. The colour is an input because
// the default near-black is invisible on TradingView's dark theme; switch it
// to a light grey there.
ema8len = input.int(8, title = "8 EMA Length")
ema8src = input.source(close, title = "8 EMA Source")
ema8col = input.color(#1A1A1A, title = "8 EMA Colour")
ema8 = ta.ema(ema8src, ema8len)

var line[] ema8Lines = array.new<line>(0)

if not na(ema8[1]) and not na(ema8)
    newEma8Line = line.new(x1 = bar_index[1], y1 = ema8[1], x2 = bar_index, y2 = ema8,
         xloc = xloc.bar_index, extend = extend.none,
         color = ema8col, style = line.style_dotted, width = 2)
    array.push(ema8Lines, newEma8Line)
    if array.size(ema8Lines) > maSegments
        line.delete(array.shift(ema8Lines))


// ------------------ Open Range Breakout -------------------------


// NOTE: inputMax is NOT the length of the opening range despite its title —
// it only gates `hide` below (plot only on charts of this timeframe or finer).
// The actual window is `sess`, currently 09:30-09:45 = 15 minutes.
inputMax = input.int(5, title= "ORB total time (minutes)")
sess = input.session("0930-0945", title="ORB Session Time")
t = time(timeframe.period, sess + ":1234567")
hide = timeframe.isintraday and timeframe.multiplier <= inputMax

is_newbar(res) => ta.change(time(res)) != 0
in_session = not na(t)
is_first = in_session and not in_session[1]

orb_high = float(na)
orb_low = float(na)

if is_first
    orb_high := high
    orb_low := low
else
    orb_high := orb_high[1]
    orb_low := orb_low[1]
    if high > orb_high and in_session
        orb_high := high
    if low < orb_low and in_session
        orb_low := low

plot(hide ? orb_high : na , style=plot.style_line, color=orb_high[1] != orb_high ? na : color.green, title="ORB High", linewidth=1)
plot(hide ? orb_low : na , style=plot.style_line, color=orb_low[1] != orb_low ? na : color.red, title="ORB Low", linewidth=1)


//---------------------- Combined email alert -----------------------
// One alert slot for both directions instead of two.
//
// SETUP: alarm-clock icon -> Condition = "SVMKR_UT_HMA_ORB", then
// "Any alert() function call" -> Notifications tab -> tick "Send email".
//
// This block must live HERE, at the end: it reads n1/n2 (HMA slope), ma200
// and the ORB levels, none of which exist yet up where the alertcondition
// calls are. Moving it up there will not compile.
//
// alert.freq_once_per_bar_close matters. The trailing stop uses
// nLoss = 2 * ATR(1) — twice the CURRENT bar's range — so it moves while the
// bar is still forming. Firing intrabar would email signals that vanish by
// the close, and would disagree with the Python daemon, which only ever acts
// on closed bars.

alertContext() =>
    hmaTxt   = n1 > n2 ? "rising" : "falling"
    ma200Txt = close > ma200 ? "above" : "below"
    orbTxt   = na(orb_high) ? "n/a" :
               close > orb_high ? "above ORB high" :
               close < orb_low  ? "below ORB low"  : "inside ORB"
    "  |  HMA " + hmaTxt + "  |  200MA " + ma200Txt + "  |  " + orbTxt

if buy
    alert("UT LONG  " + syminfo.ticker + " @ " + str.tostring(close, format.mintick)
          + alertContext(), alert.freq_once_per_bar_close)

if sell
    alert("UT SHORT " + syminfo.ticker + " @ " + str.tostring(close, format.mintick)
          + alertContext(), alert.freq_once_per_bar_close)


